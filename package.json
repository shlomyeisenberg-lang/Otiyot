{
  "name": "otiyot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:plugin": "pnpm build && node plugin/pack.mjs",
    "preview": "vite preview --port 4173",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/assistant": "^5.3.0",
    "@fontsource/frank-ruhl-libre": "^5.3.0",
    "@fontsource/noto-sans": "^5.3.0",
    "@fontsource/noto-sans-hebrew": "^5.3.0",
    "@fontsource/opendyslexic": "^5.3.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "fflate": "^0.8.3",
    "globals": "^17.14.0",
    "postprocessing": "^6.39.6",
    "prettier": "^3.9.10",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
